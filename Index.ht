  {id:11,h:"Marrocos",a:"Croácia",g:"F",dt:"23/11",hr:"07:00"},
  {id:12,h:"Bélgica",a:"Canadá",g:"F",dt:"23/11",hr:"13:00"},
  {id:13,h:"Suíça",a:"Camarões",g:"G",dt:"24/11",hr:"07:00"},
  {id:14,h:"Brasil",a:"Sérvia",g:"G",dt:"24/11",hr:"16:00"},
  {id:15,h:"Uruguai",a:"Coreia do Sul",g:"H",dt:"24/11",hr:"10:00"},
  {id:16,h:"Portugal",a:"Gana",g:"H",dt:"24/11",hr:"13:00"},
  {id:17,h:"Qatar",a:"Senegal",g:"A",dt:"25/11",hr:"13:00"},
  {id:18,h:"Holanda",a:"Equador",g:"A",dt:"25/11",hr:"16:00"},
  {id:19,h:"País de Gales",a:"Irã",g:"B",dt:"25/11",hr:"07:00"},
  {id:20,h:"Inglaterra",a:"EUA",g:"B",dt:"25/11",hr:"10:00"},
  {id:21,h:"Tunísia",a:"Austrália",g:"D",dt:"26/11",hr:"07:00"},
  {id:22,h:"Polônia",a:"Arábia Saudita",g:"C",dt:"26/11",hr:"10:00"},
  {id:23,h:"França",a:"Dinamarca",g:"D",dt:"26/11",hr:"13:00"},
  {id:24,h:"Argentina",a:"México",g:"C",dt:"26/11",hr:"16:00"},
  {id:25,h:"Japão",a:"Costa Rica",g:"E",dt:"27/11",hr:"07:00"},
  {id:26,h:"Bélgica",a:"Marrocos",g:"F",dt:"27/11",hr:"10:00"},
  {id:27,h:"Croácia",a:"Canadá",g:"F",dt:"27/11",hr:"13:00"},
  {id:28,h:"Espanha",a:"Alemanha",g:"E",dt:"27/11",hr:"16:00"},
  {id:29,h:"Camarões",a:"Sérvia",g:"G",dt:"28/11",hr:"07:00"},
  {id:30,h:"Coreia do Sul",a:"Gana",g:"H",dt:"28/11",hr:"10:00"},
  {id:31,h:"Brasil",a:"Suíça",g:"G",dt:"28/11",hr:"13:00"},
  {id:32,h:"Portugal",a:"Uruguai",g:"H",dt:"28/11",hr:"16:00"},
  {id:33,h:"Equador",a:"Senegal",g:"A",dt:"29/11",hr:"16:00"},
  {id:34,h:"Holanda",a:"Qatar",g:"A",dt:"29/11",hr:"16:00"},
  {id:35,h:"País de Gales",a:"Inglaterra",g:"B",dt:"29/11",hr:"12:00"},
  {id:36,h:"Irã",a:"EUA",g:"B",dt:"29/11",hr:"12:00"},
  {id:37,h:"Arábia Saudita",a:"México",g:"C",dt:"30/11",hr:"16:00"},
  {id:38,h:"Polônia",a:"Argentina",g:"C",dt:"30/11",hr:"16:00"},
  {id:39,h:"Austrália",a:"Dinamarca",g:"D",dt:"30/11",hr:"12:00"},
  {id:40,h:"Tunísia",a:"França",g:"D",dt:"30/11",hr:"12:00"},
  {id:41,h:"Japão",a:"Espanha",g:"E",dt:"01/12",hr:"16:00"},
  {id:42,h:"Costa Rica",a:"Alemanha",g:"E",dt:"01/12",hr:"16:00"},
  {id:43,h:"Canadá",a:"Marrocos",g:"F",dt:"01/12",hr:"12:00"},
  {id:44,h:"Croácia",a:"Bélgica",g:"F",dt:"01/12",hr:"12:00"},
  {id:45,h:"Camarões",a:"Brasil",g:"G",dt:"02/12",hr:"16:00"},
  {id:46,h:"Sérvia",a:"Suíça",g:"G",dt:"02/12",hr:"16:00"},
  {id:47,h:"Coreia do Sul",a:"Portugal",g:"H",dt:"02/12",hr:"12:00"},
  {id:48,h:"Gana",a:"Uruguai",g:"H",dt:"02/12",hr:"12:00"},
];
const KO_ROUNDS=[
  {id:"oitavas",label:"Oitavas de Final",games:[
    {id:"k1",label:"1A × 2B",dt:"03/12",hr:"12:00"},{id:"k2",label:"1C × 2D",dt:"03/12",hr:"16:00"},
    {id:"k3",label:"1D × 2C",dt:"04/12",hr:"12:00"},{id:"k4",label:"1B × 2A",dt:"04/12",hr:"16:00"},
    {id:"k5",label:"1E × 2F",dt:"05/12",hr:"12:00"},{id:"k6",label:"1G × 2H",dt:"05/12",hr:"16:00"},
    {id:"k7",label:"1F × 2E",dt:"06/12",hr:"12:00"},{id:"k8",label:"1H × 2G",dt:"06/12",hr:"16:00"},
  ]},
  {id:"quartas",label:"Quartas de Final",games:[
    {id:"k9",label:"Venc. J1 × Venc. J2",dt:"09/12",hr:"12:00"},{id:"k10",label:"Venc. J3 × Venc. J4",dt:"09/12",hr:"16:00"},
    {id:"k11",label:"Venc. J5 × Venc. J6",dt:"10/12",hr:"12:00"},{id:"k12",label:"Venc. J7 × Venc. J8",dt:"10/12",hr:"16:00"},
  ]},
  {id:"semi",label:"Semifinais",games:[
    {id:"k13",label:"Venc. Q1 × Venc. Q2",dt:"13/12",hr:"16:00"},{id:"k14",label:"Venc. Q3 × Venc. Q4",dt:"14/12",hr:"16:00"},
  ]},
  {id:"terceiro",label:"Disputa 3º Lugar",games:[
    {id:"k15",label:"Perd. S1 × Perd. S2",dt:"17/12",hr:"12:00"},
  ]},
  {id:"final",label:"🏆 Final",games:[
    {id:"k16",label:"Venc. S1 × Venc. S2",dt:"18/12",hr:"12:00"},
  ]},
];

// ════════════════════════════════════════════════════════════
// FIREBASE
// ════════════════════════════════════════════════════════════
import{initializeApp}from"https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import{getDatabase,ref,onValue,set,update,remove,get}from"https://www.gstatic.com/firebasejs/10.12.0/firebase-database.js";

let db=null;
let dbRef=null;

// ════════════════════════════════════════════════════════════
// STATE
// ════════════════════════════════════════════════════════════
let players=[];
let results={};
let koResults={};
let admin=false;
let ADMIN_PASS="copa2022";
let activePl=null;
let selAv=AVS[0];
let curTab="jogos";
let gFilter="ALL";
let expanded=new Set();

// ════════════════════════════════════════════════════════════
// SETUP
// ════════════════════════════════════════════════════════════
window.setupFirebase=async function(){
  const urlRaw=(document.getElementById("dbUrl").value||"").trim().replace(/\/+$/,"");
  const pass=(document.getElementById("setupPass").value||"").trim();
  const errDiv=document.getElementById("urlErr");
  const setupErr=document.getElementById("setupErr");

  errDiv.style.display="none";
  setupErr.style.display="none";

  if(!urlRaw.startsWith("https://")||!urlRaw.includes(".firebaseio.com")){
    errDiv.style.display="block";return;
  }
  if(pass.length<4){
    setupErr.textContent="❌ A senha precisa ter pelo menos 4 caracteres.";
    setupErr.style.display="block";return;
  }

  document.getElementById("setupForm").style.display="none";
  document.getElementById("setupLoading").style.display="block";

  try{
    const app=initializeApp({databaseURL:urlRaw},"copa");
    db=getDatabase(app);
    ADMIN_PASS=pass;

    // salva config local
    localStorage.setItem("copa_cfg",JSON.stringify({url:urlRaw,pass}));

    // testa conexão
    await get(ref(db,"_ping"));
    startApp();
  }catch(e){
    document.getElementById("setupForm").style.display="block";
    document.getElementById("setupLoading").style.display="none";
    setupErr.textContent="❌ Erro ao conectar: "+e.message+". Verifique a URL.";
    setupErr.style.display="block";
  }
};

// auto-connect se já configurado
(async()=>{
  const cfg=JSON.parse(localStorage.getItem("copa_cfg")||"null");
  if(cfg?.url){
    try{
      document.getElementById("setupScreen").innerHTML=`<div class="setup-loading"><span class="spinner"></span>Reconectando...</div>`;
      const app=initializeApp({databaseURL:cfg.url},"copa");
      db=getDatabase(app);
      ADMIN_PASS=cfg.pass||"copa2022";
      await get(ref(db,"_ping"));
      startApp();
    }catch(e){
      localStorage.removeItem("copa_cfg");
      location.reload();
    }
  }
})();

function startApp(){
  document.getElementById("setupScreen").style.display="none";
  document.getElementById("hdr").classList.add("show");
  document.getElementById("nav").classList.add("show");
  document.getElementById("main").classList.add("show");

  // listeners em tempo real
  onValue(ref(db,"players"),(snap)=>{
    players=snap.exists()?Object.values(snap.val()):[]; render();
  });
  onValue(ref(db,"results"),(snap)=>{
    results=snap.exists()?snap.val():{};render();
  });
  onValue(ref(db,"koResults"),(snap)=>{
    koResults=snap.exists()?snap.val():{};render();
  });
  onValue(ref(db,".info/connected"),(snap)=>{
    const on=snap.val();
    document.getElementById("connDot").className="conn-dot"+(on?"":" off");
    document.getElementById("connLabel").textContent=on?"Conectado":"Sem conexão";
  });
}

// ════════════════════════════════════════════════════════════
// SYNC HELPERS
// ════════════════════════════════════════════════════════════
function flashSync(){
  const b=document.getElementById("syncBar");
  b.classList.remove("show");
  void b.offsetWidth;
  b.classList.add("show");
}

// ════════════════════════════════════════════════════════════
// ADMIN
// ════════════════════════════════════════════════════════════
window.togglePassBar=function(){
  if(admin){admin=false;updateAdmBtn();render();}
  else document.getElementById("passBar").classList.toggle("show");
};
window.checkPass=function(){
  if(document.getElementById("passInp").value===ADMIN_PASS){
    admin=true;document.getElementById("passBar").classList.remove("show");
    document.getElementById("passInp").value="";updateAdmBtn();render();
  }else alert("Senha incorreta!");
};
function updateAdmBtn(){
  const b=document.getElementById("admBtn");
  b.textContent=admin?"🔓 Admin Ativo":"🔒 Admin";
  b.className=admin?"admbtn on":"admbtn";
}

// ════════════════════════════════════════════════════════════
// TABS
// ════════════════════════════════════════════════════════════
window.goTab=function(t,btn){
  curTab=t;
  document.querySelectorAll(".tab").forEach(b=>b.classList.remove("on"));
  btn.classList.add("on");
  render();
};
function render(){
  if(curTab==="jogos") renderJogos();
  else if(curTab==="apostas") renderApostas();
  else if(curTab==="ranking") renderRanking();
  else if(curTab==="matamata") renderMataMata();
  else if(curTab==="players") renderPlayers();
}

// ════════════════════════════════════════════════════════════
// HELPERS
// ════════════════════════════════════════════════════════════
const fl=t=>FL[t]||"🏳";
function rLbl(m,r){
  if(r==="home")return`${fl(m.h)} ${m.h}`;
  if(r==="away")return`${fl(m.a)} ${m.a}`;
  return"🤝 Empate";
}
function gMs(gf){return gf==="ALL"?GM:GM.filter(x=>x.g===gf);}
function byDate(arr){const d={};arr.forEach(m=>{if(!d[m.dt])d[m.dt]=[];d[m.dt].push(m);});return d;}
function filterBar(active){
  let h=`<div class="fbar"><span class="flabel">Grupo:</span>
    <button class="fg${active==="ALL"?" on":""}" onclick="setGF('ALL')">Todos</button>`;
  "ABCDEFGH".split("").forEach(g=>{
    h+=`<button class="fg${active===g?" on":""}" onclick="setGF('${g}')">${g}</button>`;
  });
  return h+`</div>`;
}
function calcRank(){
  const r=players.map(p=>{
    let pts=0,correct=0,played=0;
    GM.forEach(m=>{
      const res=results[m.id],bet=(p.bets||{})[m.id];
      if(res&&bet){played++;if(bet===res){pts+=3;correct++;}}
    });
    return{...p,pts,correct,played};
  }).sort((a,b)=>b.pts-a.pts);
  const tot=r.reduce((s,p)=>s+Math.max(p.pts,.1),0);
  return r.map(p=>({...p,chance:tot>0?Math.round(Math.max(p.pts,.1)/tot*100):Math.round(100/Math.max(r.length,1))}));
}

// ════════════════════════════════════════════════════════════
// JOGOS
// ════════════════════════════════════════════════════════════
function renderJogos(){
  const ms=gMs(gFilter);const bd=byDate(ms);
  let h=`<div class="pg-title">⚽ Jogos da Copa</div>
  <div class="pg-sub">Clique num jogo para ver todos os palpites</div>${filterBar(gFilter)}`;
  Object.keys(bd).forEach(date=>{
    h+=`<div class="dday">📅 ${date}</div>`;
    bd[date].forEach(m=>{
      const res=results[m.id];const exp=expanded.has(m.id);
      h+=matchCard(m,res,exp);
    });
  });
  if(!Object.keys(bd).length)h+=`<div class="empty"><div class="ei">⚽</div><div class="em">Sem jogos</div></div>`;
  document.getElementById("main").innerHTML=h;
}

function matchCard(m,res,exp){
  return`<div class="mc${res?" resolved":""}${exp?" expanded":""}" id="mc${m.id}">
    <div class="mh" onclick="toggleExp(${m.id})">
      <div class="mh-top">
        <span class="grptag">GRP ${m.g}</span>
        <span class="mhour">${m.hr}</span>
        <span class="mdate-sm">${m.dt}</span>
        <span class="res-badge ${res?"done":"pend"}">${res?rLbl(m,res):"Aguardando"}</span>
        <span class="exp-ico">▼</span>
      </div>
      <div class="mh-teams">
        <div class="team-side"><span class="team-flag">${fl(m.h)}</span><span class="team-nm">${m.h}</span></div>
        <span class="vs-sep">×</span>
        <div class="team-side away"><span class="team-flag">${fl(m.a)}</span><span class="team-nm">${m.a}</span></div>
      </div>
    </div>
    <div class="mb">
      ${admin?`<div class="adm-row">
        <span class="adm-lbl">Resultado:</span>
        <button class="rbtn${res==="home"?" on":""}" onclick="setRes(${m.id},'home')">${fl(m.h)} ${m.h}</button>
        <button class="rbtn${res==="draw"?" on":""}" onclick="setRes(${m.id},'draw')">🤝 Empate</button>
        <button class="rbtn${res==="away"?" on":""}" onclick="setRes(${m.id},'away')">${fl(m.a)} ${m.a}</button>
        ${res?`<button class="rbtn clr" onclick="setRes(${m.id},null)">✕ Limpar</button>`:""}
      </div>`:""}
      ${betsSection(m,res)}
    </div>
  </div>`;
}

function betsSection(m,res){
  if(!players.length)return`<div class="bets-section"><p style="font-size:13px;color:var(--t3);font-style:italic">Nenhum participante cadastrado.</p></div>`;
  let h=`<div class="bets-section"><div class="bets-lbl">Palpites dos participantes</div><div class="bets-grid">`;
  players.forEach(p=>{
    const bet=(p.bets||{})[m.id];
    const hit=res&&bet&&bet===res;const miss=res&&bet&&bet!==res;
    let chip=bet==="home"?`<span class="bchip home">${fl(m.h)} ${m.h}</span>`:
             bet==="draw"?`<span class="bchip draw">🤝 Empate</span>`:
             bet==="away"?`<span class="bchip away">${fl(m.a)} ${m.a}</span>`:
             `<span class="bchip none">sem palpite</span>`;
    const icon=res&&bet?(hit?`<span class="bicon">✅</span>`:`<span class="bicon">❌</span>`):"";
    h+=`<div class="brow${hit?" hit":miss?" miss":""}">
      <span class="bav">${p.avatar}</span><span class="bnm">${p.name}</span>${chip}${icon}
    </div>`;
  });
  return h+`</div></div>`;
}

window.toggleExp=function(id){
  if(expanded.has(id))expanded.delete(id);else expanded.add(id);
  render();
};
window.setGF=function(g){gFilter=g;expanded.clear();render();};
window.setRes=async function(id,val){
  flashSync();
  if(val===null){
    const cur={...results};delete cur[id];
    await set(ref(db,"results"),cur);
  }else{
    await update(ref(db,"results"),{[id]:val});
  }
};

// ════════════════════════════════════════════════════════════
// APOSTAS
// ════════════════════════════════════════════════════════════
function renderApostas(){
  let h=`<div class="pg-title">🎯 Registrar Palpites</div>
  <div class="pg-sub">Selecione seu nome e marque o palpite em cada jogo</div>`;
  if(!players.length){
    h+=`<div class="empty"><div class="ei">⚽</div><div class="em">Cadastre participantes primeiro</div></div>`;
    document.getElementById("main").innerHTML=h;return;
  }
  h+=`<div class="psel">`;
  players.forEach(p=>{
    const cnt=Object.keys(p.bets||{}).length;
    h+=`<button class="pchip${activePl===p.id?" on":""}" onclick="selPl('${p.id}')">
      ${p.avatar} ${p.name}<span class="ct">${cnt}</span></button>`;
  });
  h+=`</div>`;
  if(activePl){
    const p=players.find(x=>x.id===activePl);
    if(p){
      h+=`<div style="display:flex;align-items:center;gap:10px;padding:10px 14px;background:var(--s1);border:1px solid var(--border2);border-radius:10px;margin-bottom:14px">
        <span style="font-size:26px">${p.avatar}</span>
        <div><div style="font-family:var(--fn);font-size:17px;font-weight:800">${p.name}</div>
        <div style="font-size:11px;color:var(--t3)">${Object.keys(p.bets||{}).length} palpites registrados</div></div>
      </div>${filterBar(gFilter)}`;
      const ms=gMs(gFilter);const bd=byDate(ms);
      Object.keys(bd).forEach(date=>{
        h+=`<div class="dday">📅 ${date}</div>`;
        bd[date].forEach(m=>{
          const bet=(p.bets||{})[m.id];
          const res=results[m.id];
          const hit=res&&bet&&bet===res;const miss=res&&bet&&bet!==res;
          h+=`<div class="amc${hit?" hit":miss?" miss":""}">
            <div class="amc-teams">
              <div class="team-side"><span class="team-flag">${fl(m.h)}</span><span class="team-nm">${m.h}</span></div>
              <span class="vs-sep">×</span>
              <div class="team-side away"><span class="team-flag">${fl(m.a)}</span><span class="team-nm">${m.a}</span></div>
              <span style="margin-left:auto;font-size:10px;color:var(--t3);flex-shrink:0">${m.hr} · ${m.dt}</span>
            </div>
            <div class="amc-btns">
              <button class="abtn home${bet==="home"?" on":""}" onclick="doBet('${p.id}',${m.id},'home')">
                <span class="abtn-flag">${fl(m.h)}</span>${m.h}</button>
              <button class="abtn draw${bet==="draw"?" on":""}" onclick="doBet('${p.id}',${m.id},'draw')">🤝 Empate</button>
              <button class="abtn away${bet==="away"?" on":""}" onclick="doBet('${p.id}',${m.id},'away')">
                <span class="abtn-flag">${fl(m.a)}</span>${m.a}</button>
            </div>
            ${res?`<div class="amc-result">${rLbl(m,res)} ${hit?"✅ +3pts":bet?"❌ 0pts":"— sem palpite"}</div>`:""}
          </div>`;
        });
      });
    }
  }
  document.getElementById("main").innerHTML=h;
}

window.selPl=function(id){activePl=activePl===id?null:id;render();};
window.doBet=async function(pid,mid,val){
  flashSync();
  const p=players.find(x=>x.id===pid);if(!p)return;
  const bets={...(p.bets||{})};
  if(bets[mid]===val)delete bets[mid];else bets[mid]=val;
  await update(ref(db,`players/${pid}`),{bets});
};

// ════════════════════════════════════════════════════════════
// RANKING
// ════════════════════════════════════════════════════════════
function renderRanking(){
  const ranked=calcRank();
  const played=GM.filter(x=>results[x.id]).length;
  const totalBets=players.reduce((s,p)=>s+Object.keys(p.bets||{}).length,0);
  let h=`<div class="pg-title">🏆 Classificação</div>
  <div class="pg-sub">Atualiza em tempo real para todos</div>
  <div class="stats-row">
    <div class="scard"><div class="si">👥</div><div class="sv">${players.length}</div><div class="sl">Participantes</div></div>
    <div class="scard"><div class="si">⚽</div><div class="sv">${played}</div><div class="sl">Jogos Enc.</div></div>
    <div class="scard"><div class="si">📅</div><div class="sv">${GM.length-played}</div><div class="sl">Restantes</div></div>
    <div class="scard"><div class="si">🎯</div><div class="sv">${totalBets}</div><div class="sl">Palpites</div></div>
    <div class="scard"><div class="si">🥇</div><div class="sv" style="font-size:14px">${ranked[0]?.name||"—"}</div><div class="sl">Líder</div></div>
  </div>`;
  if(!ranked.length){h+=`<div class="empty"><div class="ei">👥</div><div class="em">Nenhum participante</div></div>`;
    document.getElementById("main").innerHTML=h;return;}
  const pBg=["#f0a500","#94a3b8","#d97706"];
  const medals=["🥇","🥈","🥉"];const rCls=["r1","r2","r3"];
  ranked.forEach((p,i)=>{
    h+=`<div class="rcard${i<3?" "+rCls[i]:""}">
      <div class="rpos" style="background:${i<3?pBg[i]:"var(--s2)"};color:${i<3?"#060c18":"var(--t3)"}">${i<3?medals[i]:i+1}</div>
      <div class="rav">${p.avatar}</div>
      <div class="rinfo"><div class="rnm">${p.name}</div><div class="rdet">✅ ${p.correct} acertos · 🎯 ${p.played} palpites</div></div>
      <div class="rpts"><div class="rpn" style="color:${i===0?"var(--gold)":"var(--text)"}">${p.pts}</div><div class="rpl">pontos</div></div>
      <div class="rch"><div class="rpct">${p.chance}%</div><div class="rpcl">chances</div>
        <div class="cbar"><div class="cfill" style="width:${p.chance}%"></div></div></div>
    </div>`;
  });
  document.getElementById("main").innerHTML=h;
}

// ════════════════════════════════════════════════════════════
// MATA-MATA
// ════════════════════════════════════════════════════════════
function renderMataMata(){
  let h=`<div class="pg-title">⚔️ Mata-Mata</div>
  <div class="pg-sub">${admin?"Admin: defina os confrontos e vencedores":"Acompanhe o chaveamento em tempo real"}</div>
  <div class="bracket">`;
  KO_ROUNDS.forEach(round=>{
    h+=`<div><div class="round-title">${round.label}</div><div class="round-games">`;
    round.games.forEach(kg=>{
      const ko=koResults[kg.id]||{};
      const t1=ko.t1||"";const t2=ko.t2||"";const w=ko.w||"";
      h+=`<div class="kmatch${w?" done":""}">
        <div class="km-label">⏰ ${kg.hr} · ${kg.dt} · ${kg.label}</div>
        <div class="km-slot${w===t1&&t1?" winner":""}">
          ${t1?`<span class="km-flag">${fl(t1)}</span><span class="km-name">${t1}</span>${w===t1?`<span class="km-w">✅</span>`:""}`:
               `<span class="km-tbd">A definir</span>`}
        </div>
        <div class="km-slot${w===t2&&t2?" winner":""}">
          ${t2?`<span class="km-flag">${fl(t2)}</span><span class="km-name">${t2}</span>${w===t2?`<span class="km-w">✅</span>`:""}`:
               `<span class="km-tbd">A definir</span>`}
        </div>
        ${admin?koAdmin(kg,t1,t2,w):""}
      </div>`;
    });
    h+=`</div></div>`;
  });
  h+=`</div>`;
  if(!admin)h+=`<div style="text-align:center;padding:20px;font-size:12px;color:var(--t3)">🔒 Entre como admin para editar confrontos</div>`;
  document.getElementById("main").innerHTML=h;
}

function koAdmin(kg,t1,t2,w){
  const opts=Object.keys(FL);
  const sel=(val,field)=>{
    let s=`<select class="ksel" onchange="setKO('${kg.id}','${field}',this.value)">
      <option value="">Time ${field==="t1"?"1":"2"}...</option>`;
    opts.forEach(t=>{s+=`<option value="${t}"${val===t?" selected":""}>${fl(t)} ${t}</option>`;});
    return s+`</select>`;
  };
  return`<div class="kadm">
    ${sel(t1,"t1")}${sel(t2,"t2")}
    ${t1?`<button class="kbtn${w===t1?" on":""}" onclick="setKO('${kg.id}','w','${t1}')">${fl(t1)} Venceu</button>`:""}
    ${t2?`<button class="kbtn${w===t2?" on":""}" onclick="setKO('${kg.id}','w','${t2}')">${fl(t2)} Venceu</button>`:""}
    ${w?`<button class="kbtn clr" onclick="setKO('${kg.id}','w','')">✕</button>`:""}
  </div>`;
}

window.setKO=async function(kid,field,val){
  flashSync();
  const cur={...(koResults[kid]||{})};
  if(!val)delete cur[field];else cur[field]=val;
  if(field==="w"&&!val)delete cur.w;
  await update(ref(db,"koResults"),{[kid]:cur});
};

// ════════════════════════════════════════════════════════════
// PLAYERS
// ════════════════════════════════════════════════════════════
function renderPlayers(){
  const ranked=calcRank();
  let h=`<div class="pg-title">👥 Participantes</div>
  <div class="pg-sub">Gerencie os participantes do bolão</div>
  <div class="addbox"><h3>➕ Adicionar Participante</h3>
    <div class="addinp-row">
      <input id="newNm" placeholder="Nome do participante..." onkeydown="if(event.key==='Enter')addPl()"/>
      <button onclick="addPl()">Adicionar</button>
    </div>
    <div class="av-lbl">Escolha um avatar:</div>
    <div class="av-pick">`;
  AVS.forEach(a=>{h+=`<button class="avb${selAv===a?" on":""}" onclick="pickAv('${a}')">${a}</button>`;});
  h+=`</div></div>`;
  if(!ranked.length){h+=`<div class="empty"><div class="ei">👥</div><div class="em">Nenhum participante ainda</div></div>`;}
  else ranked.forEach((p,i)=>{
    h+=`<div class="pcard"><div class="pcav">${p.avatar}</div>
      <div class="pcinf"><div class="pcnm">${p.name}</div>
      <div class="pcdt">${Object.keys(p.bets||{}).length} palpites · ${p.pts} pts · #${i+1}</div></div>
      <button class="delbtn" onclick="delPl('${p.id}')">Remover</button>
    </div>`;
  });
  h+=`<div class="rules"><h4>ℹ️ Regras</h4>
    <p>✅ <strong style="color:var(--green)">+3 pontos</strong> — Acertou o resultado<br>
    ❌ <strong style="color:var(--red)">0 pontos</strong> — Errou o palpite<br>
    🔒 Admin: quem criou o bolão sabe a senha</p>
  </div>`;
  document.getElementById("main").innerHTML=h;
}

window.pickAv=function(a){selAv=a;renderPlayers();};
window.addPl=async function(){
  const el=document.getElementById("newNm");
  const n=(el?.value||"").trim();
  if(!n)return;
  if(players.find(p=>p.name.toLowerCase()===n.toLowerCase())){alert("Nome já existe!");return;}
  flashSync();
  const id="p"+Date.now();
  await set(ref(db,`players/${id}`),{id,name:n,avatar:selAv,bets:{}});
  const e=document.getElementById("newNm");if(e)e.value="";
};
window.delPl=async function(id){
  if(!confirm("Remover participante?"))return;
  flashSync();
  await remove(ref(db,`players/${id}`));
  if(activePl===id)activePl=null;
};
</script>
</body>
</html>
