<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>🏆 Copa Apostas 2022</title>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800;900&family=Barlow:wght@300;400;500;600&display=swap" rel="stylesheet"/>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#060c18;--s1:#0c1525;--s2:#111e30;--s3:#16263c;
  --border:#1d3050;--border2:#274165;
  --gold:#f0a500;--green:#00d97e;--red:#ff4d6d;--blue:#4a9eff;--purple:#a78bfa;
  --text:#dce8f5;--t2:#7a9ab8;--t3:#3d5a75;
  --fn:'Barlow Condensed',sans-serif;--fb:'Barlow',sans-serif;
}
html,body{min-height:100vh;background:var(--bg);color:var(--text);font-family:var(--fb)}
button,input,select{font-family:var(--fb)}

/* ══ SETUP SCREEN ══ */
#setupScreen{position:fixed;inset:0;background:var(--bg);z-index:999;display:flex;align-items:center;justify-content:center;padding:20px}
.setup-box{background:var(--s1);border:1px solid var(--border2);border-radius:18px;padding:30px 24px;max-width:480px;width:100%}
.setup-logo{text-align:center;margin-bottom:24px}
.setup-logo .ico{font-size:48px;display:block;margin-bottom:8px}
.setup-logo .t1{font-family:var(--fn);font-size:28px;font-weight:900;color:var(--gold);letter-spacing:1px}
.setup-logo .t2{font-size:12px;color:var(--t3);letter-spacing:2px;text-transform:uppercase;margin-top:2px}
.setup-step{margin-bottom:20px}
.setup-step h3{font-family:var(--fn);font-size:14px;font-weight:800;color:var(--t2);letter-spacing:1px;text-transform:uppercase;margin-bottom:10px;display:flex;align-items:center;gap:8px}
.setup-step h3 .sn{background:var(--gold);color:#060c18;width:20px;height:20px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:12px}
.setup-inp{width:100%;background:var(--s2);border:1px solid var(--border);border-radius:9px;padding:10px 14px;color:var(--text);font-size:14px;outline:none;margin-bottom:8px;transition:.2s}
.setup-inp:focus{border-color:var(--gold)}
.setup-hint{font-size:12px;color:var(--t3);line-height:1.6;margin-bottom:8px}
.setup-hint a{color:var(--blue);text-decoration:none}
.setup-hint a:hover{text-decoration:underline}
.setup-btn{width:100%;font-family:var(--fn);background:var(--gold);border:none;border-radius:10px;padding:13px;font-size:16px;font-weight:800;color:#060c18;cursor:pointer;letter-spacing:.5px;margin-top:8px;transition:.2s}
.setup-btn:hover{background:var(--gold2,#ffd060)}
.setup-btn:disabled{background:var(--t3);cursor:not-allowed}
.setup-err{background:#ff4d6d18;border:1px solid #ff4d6d44;color:var(--red);border-radius:8px;padding:10px 12px;font-size:13px;margin-top:8px;display:none}
.setup-loading{text-align:center;padding:20px;color:var(--t2);font-size:14px}
.spinner{display:inline-block;width:20px;height:20px;border:2px solid var(--border2);border-top-color:var(--gold);border-radius:50%;animation:spin .7s linear infinite;margin-right:8px;vertical-align:middle}
@keyframes spin{to{transform:rotate(360deg)}}

/* ══ SYNC INDICATOR ══ */
#syncBar{position:fixed;top:0;left:0;right:0;height:2px;background:var(--gold);z-index:500;transform:scaleX(0);transform-origin:left;transition:transform .3s;display:none}
#syncBar.show{display:block;animation:syncAnim 1s ease-out forwards}
@keyframes syncAnim{0%{transform:scaleX(0)}60%{transform:scaleX(.8)}100%{transform:scaleX(1);opacity:0}}

/* ══ HEADER ══ */
header{background:linear-gradient(180deg,#0a1828,#060c18);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:200;display:none}
header.show{display:block}
.hdr{max-width:960px;margin:0 auto;padding:0 14px;display:flex;align-items:center;justify-content:space-between;height:56px;gap:8px}
.brand{display:flex;align-items:center;gap:10px;flex-shrink:0}
.b-t1{font-family:var(--fn);font-weight:900;font-size:20px;color:var(--gold);letter-spacing:1px;line-height:1}
.b-t2{font-size:9px;color:var(--t3);letter-spacing:2px;text-transform:uppercase}
.hdr-r{display:flex;align-items:center;gap:6px}
.conn-dot{width:8px;height:8px;border-radius:50%;background:var(--green);margin-right:2px;transition:background .3s}
.conn-dot.off{background:var(--red)}
.conn-label{font-size:11px;color:var(--t2)}
.admbtn{font-family:var(--fn);background:var(--s2);border:1px solid var(--border2);color:var(--t2);border-radius:6px;padding:6px 12px;font-size:13px;font-weight:700;cursor:pointer;transition:.2s}
.admbtn.on{background:#00d97e15;border-color:#00d97e55;color:var(--green)}

/* ══ PASS BAR ══ */
.passbar{display:none;background:var(--s1);border-bottom:1px solid var(--border);padding:10px 14px}
.passbar.show{display:flex;gap:8px;max-width:960px;margin:0 auto;flex-wrap:wrap}
.passbar input{flex:1;min-width:160px;background:var(--s2);border:1px solid var(--border);border-radius:7px;padding:8px 12px;color:var(--text);font-size:13px;outline:none}
.passbar input:focus{border-color:var(--gold)}
.passbar button{font-family:var(--fn);background:var(--gold);border:none;border-radius:7px;padding:8px 18px;font-weight:800;font-size:13px;color:#060c18;cursor:pointer}

/* ══ NAV ══ */
nav{background:var(--s1);border-bottom:1px solid var(--border);overflow-x:auto;-webkit-overflow-scrolling:touch;display:none}
nav.show{display:block}
.nav-i{max-width:960px;margin:0 auto;padding:0 14px;display:flex}
.tab{font-family:var(--fn);background:none;border:none;border-bottom:3px solid transparent;color:var(--t3);padding:12px 16px;font-size:15px;font-weight:700;white-space:nowrap;cursor:pointer;transition:.15s;text-transform:uppercase;letter-spacing:.5px}
.tab.on{border-bottom-color:var(--gold);color:var(--gold)}

/* ══ MAIN ══ */
main{max-width:960px;margin:0 auto;padding:18px 12px 80px;display:none}
main.show{display:block}
.pg-title{font-family:var(--fn);font-size:26px;font-weight:900;color:var(--gold);letter-spacing:1px;margin-bottom:2px}
.pg-sub{font-size:12px;color:var(--t3);margin-bottom:20px}

/* ══ FILTER BAR ══ */
.fbar{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:16px;align-items:center}
.flabel{font-size:10px;color:var(--t3);font-weight:700;letter-spacing:1.5px;text-transform:uppercase;margin-right:2px}
.fg{font-family:var(--fn);background:var(--s2);border:1px solid var(--border);color:var(--t2);border-radius:6px;padding:5px 12px;font-size:14px;font-weight:700;cursor:pointer;transition:.15s}
.fg.on{background:var(--gold);border-color:var(--gold);color:#060c18}

/* ══ DAY DIVIDER ══ */
.dday{font-family:var(--fn);font-size:11px;font-weight:700;color:var(--t3);letter-spacing:2px;text-transform:uppercase;padding:18px 0 8px;display:flex;align-items:center;gap:8px}
.dday::after{content:'';flex:1;height:1px;background:var(--border)}

/* ══ MATCH CARD ══ */
.mc{background:var(--s1);border:1px solid var(--border);border-radius:12px;margin-bottom:8px;overflow:hidden;transition:border-color .2s}
.mc.resolved{border-color:#00d97e28}
.mc.expanded{border-color:var(--border2)}
.mh{padding:12px 14px;cursor:pointer;user-select:none}
.mh-top{display:flex;align-items:center;gap:8px;margin-bottom:10px;flex-wrap:wrap}
.grptag{font-family:var(--fn);font-size:10px;font-weight:800;letter-spacing:1px;color:var(--t3);background:var(--s2);border:1px solid var(--border);border-radius:4px;padding:2px 7px;flex-shrink:0}
.mhour{font-family:var(--fn);font-size:13px;font-weight:700;color:var(--t2);flex-shrink:0}
.mdate-sm{font-size:10px;color:var(--t3)}
.res-badge{font-family:var(--fn);font-size:11px;font-weight:800;padding:2px 10px;border-radius:20px;margin-left:auto;white-space:nowrap;flex-shrink:0}
.res-badge.done{background:#00d97e18;color:var(--green);border:1px solid #00d97e33}
.res-badge.pend{background:var(--s2);color:var(--t3);border:1px solid var(--border)}
.exp-ico{color:var(--t3);font-size:11px;margin-left:6px;transition:transform .2s;flex-shrink:0}
.mc.expanded .exp-ico{transform:rotate(180deg)}
.mh-teams{display:flex;align-items:center}
.team-side{display:flex;align-items:center;gap:6px;flex:1;min-width:0}
.team-side.away{flex-direction:row-reverse}
.team-flag{font-size:22px;flex-shrink:0}
.team-nm{font-family:var(--fn);font-size:17px;font-weight:800;letter-spacing:.3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.vs-sep{font-family:var(--fn);font-size:13px;font-weight:700;color:var(--t3);padding:0 10px;flex-shrink:0}
.mb{display:none;border-top:1px solid var(--border)}
.mc.expanded .mb{display:block}
.adm-row{padding:12px 14px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:6px;flex-wrap:wrap;background:var(--bg)}
.adm-lbl{font-size:10px;color:var(--t3);font-weight:700;letter-spacing:1.5px;text-transform:uppercase;margin-right:4px;flex-shrink:0}
.rbtn{font-family:var(--fn);font-size:13px;font-weight:700;padding:6px 12px;border-radius:6px;border:1.5px solid var(--border);background:var(--s2);color:var(--t2);cursor:pointer;transition:.15s;white-space:nowrap}
.rbtn:hover{border-color:var(--gold);color:var(--gold)}
.rbtn.on{border-color:var(--gold);background:#f0a50018;color:var(--gold)}
.rbtn.clr{border-color:#ff4d6d33;color:#ff4d6d66;font-size:11px}
.rbtn.clr:hover{border-color:var(--red);color:var(--red)}
.bets-section{padding:12px 14px}
.bets-lbl{font-size:10px;color:var(--t3);font-weight:700;letter-spacing:1.5px;text-transform:uppercase;margin-bottom:10px}
.bets-grid{display:flex;flex-direction:column;gap:5px}
.brow{display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:8px;background:var(--s2);border:1px solid var(--border)}
.brow.hit{background:#00d97e0d;border-color:#00d97e28}
.brow.miss{background:#ff4d6d0a;border-color:#ff4d6d25}
.bav{font-size:18px;flex-shrink:0}
.bnm{font-family:var(--fn);font-size:15px;font-weight:700;flex:1;min-width:0;letter-spacing:.3px}
.bchip{font-family:var(--fn);font-size:12px;font-weight:700;padding:3px 10px;border-radius:20px;white-space:nowrap;flex-shrink:0}
.bchip.home{background:#4a9eff18;color:var(--blue);border:1px solid #4a9eff33}
.bchip.draw{background:#f0a50018;color:var(--gold);border:1px solid #f0a50033}
.bchip.away{background:#a78bfa18;color:var(--purple);border:1px solid #a78bfa33}
.bchip.none{background:none;color:var(--t3);border:1px solid var(--border);font-style:italic;font-weight:400}
.bicon{font-size:16px;flex-shrink:0}

/* ══ APOSTAS ══ */
.psel{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:18px}
.pchip{font-family:var(--fn);background:var(--s2);border:2px solid var(--border);color:var(--t2);border-radius:8px;padding:8px 14px;font-size:14px;font-weight:700;cursor:pointer;display:flex;align-items:center;gap:7px;transition:.15s}
.pchip .ct{font-size:10px;opacity:.6;background:var(--s1);border-radius:10px;padding:1px 6px}
.pchip.on{background:#f0a50012;border-color:var(--gold);color:var(--gold)}
.pchip.on .ct{opacity:1}
.amc{background:var(--s1);border:1px solid var(--border);border-radius:11px;margin-bottom:8px;overflow:hidden}
.amc.hit{border-color:#00d97e33}
.amc.miss{border-color:#ff4d6d28}
.amc-teams{display:flex;align-items:center;padding:11px 13px 8px;border-bottom:1px solid var(--border)}
.amc-btns{display:flex}
.abtn{flex:1;font-family:var(--fn);font-size:13px;font-weight:700;padding:9px 4px;border:none;border-right:1px solid var(--border);background:var(--s2);color:var(--t3);cursor:pointer;transition:.15s;display:flex;align-items:center;justify-content:center;gap:4px;white-space:nowrap}
.abtn:last-child{border-right:none}
.abtn:hover{background:var(--s3);color:var(--t2)}
.abtn.on.home{background:#4a9eff18;color:var(--blue)}
.abtn.on.draw{background:#f0a50018;color:var(--gold)}
.abtn.on.away{background:#a78bfa18;color:var(--purple)}
.abtn-flag{font-size:15px}
.amc-result{padding:5px 13px 7px;font-size:11px;color:var(--t3);display:flex;align-items:center;gap:6px}

/* ══ RANKING ══ */
.stats-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(110px,1fr));gap:7px;margin-bottom:22px}
.scard{background:var(--s1);border:1px solid var(--border);border-radius:10px;padding:12px 10px}
.scard .si{font-size:16px;margin-bottom:5px}
.scard .sv{font-family:var(--fn);font-size:21px;font-weight:900;color:var(--gold)}
.scard .sl{font-size:10px;color:var(--t3);margin-top:2px}
.rcard{display:flex;align-items:center;gap:12px;padding:13px 16px;border-radius:12px;border:1px solid var(--border);background:var(--s1);margin-bottom:7px;transition:transform .15s}
.rcard:hover{transform:translateX(3px)}
.rcard.r1{background:linear-gradient(135deg,#162e0a,#1a3510);border-color:#00d97e2a}
.rcard.r2{background:linear-gradient(135deg,#1a2030,#1c2235);border-color:#94a3b828}
.rcard.r3{background:linear-gradient(135deg,#2a1c0a,#291a09);border-color:#d9770633}
.rpos{width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:var(--fn);font-weight:900;font-size:13px;flex-shrink:0}
.rav{font-size:24px;flex-shrink:0}
.rinfo{flex:1;min-width:0}
.rnm{font-family:var(--fn);font-size:17px;font-weight:800;letter-spacing:.3px}
.rdet{font-size:11px;color:var(--t3);margin-top:2px}
.rpts{text-align:right;flex-shrink:0}
.rpn{font-family:var(--fn);font-size:28px;font-weight:900;line-height:1}
.rpl{font-size:10px;color:var(--t3)}
.rch{min-width:60px;text-align:center;flex-shrink:0}
.rpct{font-family:var(--fn);font-size:14px;font-weight:800;color:var(--green)}
.rpcl{font-size:10px;color:var(--t3)}
.cbar{height:3px;background:var(--s2);border-radius:2px;margin-top:5px}
.cfill{height:3px;border-radius:2px;background:linear-gradient(90deg,var(--gold),var(--green));transition:width .8s}

/* ══ MATA-MATA ══ */
.bracket{display:flex;flex-direction:column;gap:22px}
.round-title{font-family:var(--fn);font-size:13px;font-weight:800;color:var(--t3);letter-spacing:2px;text-transform:uppercase;margin-bottom:10px;display:flex;align-items:center;gap:8px}
.round-title::after{content:'';flex:1;height:1px;background:var(--border)}
.round-games{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:8px}
.kmatch{background:var(--s1);border:1px solid var(--border);border-radius:10px;overflow:hidden}
.kmatch.done{border-color:#00d97e28}
.km-label{font-size:10px;color:var(--t3);letter-spacing:1px;text-transform:uppercase;padding:6px 13px;background:var(--bg);border-bottom:1px solid var(--border);font-weight:700}
.km-slot{display:flex;align-items:center;gap:10px;padding:10px 13px;border-bottom:1px solid var(--border)}
.km-slot:last-of-type{border-bottom:none}
.km-slot.winner{background:#00d97e0a}
.km-flag{font-size:20px;flex-shrink:0}
.km-name{font-family:var(--fn);font-size:16px;font-weight:700;flex:1;letter-spacing:.3px}
.km-w{font-size:14px;flex-shrink:0}
.km-tbd{font-family:var(--fn);font-size:13px;color:var(--t3);font-style:italic}
.kadm{padding:8px 13px;background:var(--bg);border-top:1px solid var(--border);display:flex;gap:5px;flex-wrap:wrap}
.ksel{background:var(--s2);border:1px solid var(--border);border-radius:5px;padding:5px 8px;color:var(--text);font-size:12px;cursor:pointer;flex:1;min-width:100px;outline:none}
.ksel:focus{border-color:var(--gold)}
.kbtn{font-family:var(--fn);font-size:12px;font-weight:700;padding:5px 10px;border-radius:5px;border:1px solid var(--border);background:var(--s2);color:var(--t2);cursor:pointer;transition:.15s;white-space:nowrap}
.kbtn:hover{border-color:var(--gold);color:var(--gold)}
.kbtn.on{border-color:var(--gold);background:#f0a50015;color:var(--gold)}
.kbtn.clr{border-color:#ff4d6d33;color:#ff4d6d66;font-size:11px}
.kbtn.clr:hover{border-color:var(--red);color:var(--red)}

/* ══ PLAYERS ══ */
.addbox{background:var(--s1);border:1px solid var(--border);border-radius:12px;padding:18px;margin-bottom:16px}
.addbox h3{font-family:var(--fn);font-size:14px;font-weight:700;color:var(--t2);margin-bottom:12px;letter-spacing:.5px;text-transform:uppercase}
.addinp-row{display:flex;gap:7px;margin-bottom:12px;flex-wrap:wrap}
.addinp-row input{flex:1;min-width:160px;background:var(--s2);border:1px solid var(--border);border-radius:8px;padding:9px 12px;color:var(--text);font-size:14px;outline:none}
.addinp-row input:focus{border-color:var(--gold)}
.addinp-row button{font-family:var(--fn);background:var(--gold);border:none;border-radius:8px;padding:9px 18px;font-weight:800;font-size:13px;color:#060c18;cursor:pointer}
.av-lbl{font-size:10px;color:var(--t3);font-weight:700;letter-spacing:1px;text-transform:uppercase;margin-bottom:6px}
.av-pick{display:flex;gap:5px;flex-wrap:wrap}
.avb{font-size:20px;background:none;border:2px solid var(--border);border-radius:7px;padding:3px 7px;cursor:pointer;transition:.15s}
.avb.on{border-color:var(--gold);background:#f0a50012}
.pcard{display:flex;align-items:center;gap:12px;padding:12px 16px;border-radius:11px;background:var(--s1);border:1px solid var(--border);margin-bottom:7px}
.pcav{font-size:26px}
.pcinf{flex:1;min-width:0}
.pcnm{font-family:var(--fn);font-size:16px;font-weight:800;letter-spacing:.3px}
.pcdt{font-size:11px;color:var(--t3);margin-top:2px}
.delbtn{font-family:var(--fn);background:var(--s2);border:1px solid var(--border);color:var(--red);border-radius:6px;padding:5px 11px;font-size:12px;font-weight:700;cursor:pointer;opacity:.7;transition:.2s}
.delbtn:hover{opacity:1;border-color:var(--red)}
.rules{background:var(--s1);border:1px solid var(--border);border-radius:11px;padding:16px;margin-top:16px}
.rules h4{font-family:var(--fn);font-size:12px;font-weight:700;color:var(--t3);letter-spacing:1.5px;text-transform:uppercase;margin-bottom:10px}
.rules p{font-size:13px;color:var(--t2);line-height:1.9}

/* ══ EMPTY ══ */
.empty{text-align:center;padding:50px 16px;color:var(--t3)}
.empty .ei{font-size:46px;margin-bottom:12px}
.empty .em{font-family:var(--fn);font-size:18px;font-weight:700;color:#2a3d52}
.empty .es{font-size:12px;margin-top:5px}

::-webkit-scrollbar{width:3px;height:3px}
::-webkit-scrollbar-track{background:var(--bg)}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:3px}
@media(max-width:480px){
  .team-nm{font-size:15px}
  .rcard{padding:10px 12px}
  .rpn{font-size:24px}
  .abtn{font-size:11px;padding:8px 2px}
  .abtn-flag{display:none}
}
</style>
</head>
<body>

<!-- SYNC BAR -->
<div id="syncBar"></div>

<!-- ══ SETUP SCREEN ══════════════════════════════════════ -->
<div id="setupScreen">
  <div class="setup-box">
    <div class="setup-logo">
      <span class="ico">🏆</span>
      <div class="t1">COPA APOSTAS</div>
      <div class="t2">Qatar 2022 · Entre Amigos</div>
    </div>

    <div id="setupForm">
      <div class="setup-step">
        <h3><span class="sn">1</span> Criar banco de dados gratuito</h3>
        <div class="setup-hint">
          1. Acesse <a href="https://console.firebase.google.com" target="_blank">console.firebase.google.com</a><br>
          2. Clique em <strong>"Adicionar projeto"</strong> → dê um nome (ex: copa-amigos)<br>
          3. Desative o Google Analytics → Criar projeto<br>
          4. No menu lateral: <strong>Realtime Database → Criar banco de dados</strong><br>
          5. Escolha <strong>"Iniciar no modo de teste"</strong> → Ativar<br>
          6. Copie a URL do banco (ex: <em>https://copa-amigos-default-rtdb.firebaseio.com</em>)
        </div>
      </div>

      <div class="setup-step">
        <h3><span class="sn">2</span> Cole a URL do seu banco</h3>
        <input class="setup-inp" type="url" id="dbUrl" placeholder="https://seu-projeto-default-rtdb.firebaseio.com" autocomplete="off"/>
        <div class="setup-hint" style="color:var(--red);display:none" id="urlErr">❌ URL inválida. Deve começar com https:// e terminar com .firebaseio.com</div>
      </div>

      <div class="setup-step">
        <h3><span class="sn">3</span> Defina a senha do admin</h3>
        <input class="setup-inp" type="password" id="setupPass" placeholder="Crie uma senha para o admin (mín. 4 caracteres)"/>
        <div class="setup-hint">O admin pode lançar resultados e gerenciar o bolão.</div>
      </div>

      <button class="setup-btn" onclick="setupFirebase()">🚀 Criar Bolão</button>
      <div class="setup-err" id="setupErr"></div>
    </div>

    <div id="setupLoading" style="display:none" class="setup-loading">
      <span class="spinner"></span>Conectando ao banco de dados...
    </div>
  </div>
</div>

<!-- ══ APP ═══════════════════════════════════════════════ -->
<header id="hdr">
  <div class="hdr">
    <div class="brand">
      <span style="font-size:22px">🏆</span>
      <div>
        <div class="b-t1">COPA APOSTAS</div>
        <div class="b-t2">Qatar 2022</div>
      </div>
    </div>
    <div class="hdr-r">
      <span class="conn-dot" id="connDot"></span>
      <span class="conn-label" id="connLabel">Conectado</span>
      <button class="admbtn" id="admBtn" onclick="togglePassBar()" style="margin-left:8px">🔒 Admin</button>
    </div>
  </div>
  <div class="passbar" id="passBar">
    <input type="password" id="passInp" placeholder="Senha admin" onkeydown="if(event.key==='Enter')checkPass()"/>
    <button onclick="checkPass()">Entrar</button>
  </div>
</header>

<nav id="nav">
  <div class="nav-i">
    <button class="tab on" onclick="goTab('jogos',this)">⚽ Jogos</button>
    <button class="tab" onclick="goTab('apostas',this)">🎯 Palpites</button>
    <button class="tab" onclick="goTab('ranking',this)">🏆 Ranking</button>
    <button class="tab" onclick="goTab('matamata',this)">⚔️ Mata-Mata</button>
    <button class="tab" onclick="goTab('players',this)">👥 Participantes</button>
  </div>
</nav>

<main id="main"></main>

<script type="module">
// ════════════════════════════════════════════════════════════
// MATCH DATA
// ════════════════════════════════════════════════════════════
